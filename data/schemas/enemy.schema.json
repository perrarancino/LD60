{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EnemyConfig",
  "description": "Схема конфигурации обычных противников (строго 1 вид атаки на врага)",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "lore",
    "location_id",
    "sprite_variants",
    "stats",
    "behavior_type",
    "attack",
    "drops"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Уникальный строковый идентификатор противника"
    },
    "display_name": {
      "type": "string",
      "description": "Имя противника на русском"
    },
    "location_id": {
      "type": "string",
      "description": "Основная локация обитания врага"
    },
    "lore": {
      "type": "string",
      "description": "Лор и визуальное описание противника"
    },
    "sprite_variants": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string" },
      "description": "Id спрайтов из data/sprites/sprites.json (может быть пустым на этапе геймдизайна)"
    },
    "spawns": {
      "type": "object",
      "description": "Только для spawner: враг сидит на фоне и время от времени выплёвывает других врагов",
      "required": ["enemy_id", "interval_seconds", "max_alive"],
      "properties": {
        "enemy_id": { "type": "string", "description": "Кого выплёвывает (id врага)" },
        "sprite_id": { "type": "string", "description": "Вариант внешности порождаемого врага" },
        "interval_seconds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number", "minimum": 0.5 }, "description": "Пауза между плевками: [от, до]" },
        "max_alive": { "type": "integer", "minimum": 1, "description": "Сколько порождённых может быть живо одновременно" },
        "scale": { "type": "number", "minimum": 0.1, "description": "Размер порождённого относительно обычного (паучки меньше)" },
        "lifetime_seconds": { "type": "number", "minimum": 1, "description": "Через сколько секунд порождённый исчезает (по умолчанию — не исчезает)" }
      }
    },
    "summons": {
      "type": "object",
      "description": "Для flying_bird (босс-птица): кого призывает, когда садится на пол; для flying_worm (босс-червь): кого выкидывает из тела в атаке «Паучий дождь»",
      "required": ["enemy_ids", "count"],
      "properties": {
        "enemy_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Из кого выбирает (id врагов локации, случайно)" },
        "count": { "type": "integer", "minimum": 1, "description": "Сколько призывает за одну посадку" },
        "max_alive": { "type": "integer", "minimum": 1, "description": "Сколько призванных может быть живо одновременно" }
      }
    },
    "rig_id": { "type": "string", "description": "Id процедурного рига из data/rigs/ (для врагов, собранных из частей-слоёв, например паук)" },
    "stats": {
      "type": "object",
      "required": ["max_health", "contact_damage", "movement_speed"],
      "properties": {
        "max_health": { "type": "integer", "minimum": 1 },
        "contact_damage": { "type": "integer", "minimum": 0 },
        "movement_speed": { "type": "number", "minimum": 0.0 }
      }
    },
    "behavior_type": {
      "type": "string",
      "enum": [
        "patrol_crawler",
        "jumper",
        "ranged",
        "flying",
        "flying_fan",
        "accordion_coil",
        "spitter",
        "polarity_flipper",
        "diver",
        "bouncing_projectile",
        "crawler",
        "burrower",
        "flying_worm",
        "flying_bird",
        "crab_boss",
        "critter",
        "spawner"
      ],
      "description": "Базовый тип передвижения и поиска целей"
    },
    "attack": {
      "type": "object",
      "description": "Единственный вид атаки данного противника",
      "required": ["name", "damage", "cooldown_seconds", "range", "description"],
      "properties": {
        "name": { "type": "string" },
        "damage": { "type": "integer", "minimum": 0 },
        "cooldown_seconds": { "type": "number", "minimum": 0.0 },
        "range": { "type": "number", "minimum": 0.0 },
        "projectile_type": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "drops": {
      "type": "object",
      "required": ["scrap_parts_min", "scrap_parts_max", "drop_chance_percent"],
      "properties": {
        "scrap_parts_min": { "type": "integer", "minimum": 0 },
        "scrap_parts_max": { "type": "integer", "minimum": 0 },
        "drop_chance_percent": { "type": "number", "minimum": 0.0, "maximum": 100.0 }
      }
    }
  }
}
