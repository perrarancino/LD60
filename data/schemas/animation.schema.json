{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FrameAnimation",
  "description": "Заготовленная покадровая анимация из частей-слоёв: кадр = целочисленные сдвиги частей относительно позы из рисунка (пиксель-арт без поворотов и растяжения).",
  "type": "object",
  "required": [
    "id",
    "clips"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "clips": {
      "type": "object",
      "description": "Клипы по имени (walk, idle, ...)",
      "additionalProperties": {
        "type": "object",
        "required": [
          "frames"
        ],
        "properties": {
          "loop": {
            "type": "boolean"
          },
          "fps": {
            "type": "number",
            "minimum": 0,
            "description": "Скорость воспроизведения, кадров в секунду (для клипов на месте)"
          },
          "px_per_frame": {
            "type": "number",
            "minimum": 0,
            "description": "Для клипов хода: путь тела за кадр, px (кадров в секунду = скорость / px_per_frame — стопа в опоре не скользит)"
          },
          "frames": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "description": "Имя части -> [dx, dy] в целых пикселях (y вниз)",
              "additionalProperties": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
