{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig",
  "description": "Процедурный риг персонажа из частей-слоёв. Все части — полнохолстные спрайты в одних координатах; pivot задаёт точку вращения.",
  "type": "object",
  "required": ["id", "canvas", "anchor", "parts"],
  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "anchor": {
      "type": "object",
      "description": "Точка холста, которая ставится в позицию тела (ноги, низ по центру)",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "crawler": {
      "type": "object",
      "description": "Ползающее существо (паук): тело на двухфаланговых ногах",
      "required": ["body_raise", "legs"],
      "properties": {
        "body_raise": { "type": "number", "minimum": 0, "description": "На сколько px тело поднято над поверхностью ногами" },
        "leg_spread": { "type": "number", "minimum": 0, "description": "Множитель разноса стоп (1 — как в рисунке)" },
        "leg_splay": { "type": "number", "minimum": 0, "description": "Дополнительный разброс стоп наружу от центра тела, px" },
        "body_centre_x": { "type": "number", "description": "Центр тела по X на холсте (px); по умолчанию — якорь" },
        "legs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "upper_sprite_id", "lower_sprite_id", "hip", "knee", "foot", "gait_group"],
            "properties": {
              "name": { "type": "string" },
              "upper_sprite_id": { "type": "string", "description": "Верхняя фаланга (бедро -> колено), id спрайта-слоя" },
              "lower_sprite_id": { "type": "string", "description": "Нижняя фаланга (колено -> стопа), id спрайта-слоя" },
              "hip": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "knee": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "foot": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "gait_group": { "type": "integer", "minimum": 0, "description": "Группа походки: ноги одной группы шагают одновременно" }
            }
          }
        }
      }
    },
    "critter": {
      "type": "object",
      "description": "Небольшое существо из слоёв с процедурной анимацией: ходит, скачет, летает или стоит и следит за героем",
      "required": ["kind", "draw_facing", "hit", "parts"],
      "properties": {
        "kind": { "type": "string", "enum": ["walker", "hopper", "flyer", "watcher"] },
        "draw_facing": { "type": "integer", "enum": [-1, 1], "description": "Куда смотрит рисунок (−1 — влево)" },
        "stride": { "type": "number", "description": "Рад фазы шага на пиксель пути" },
        "sight": { "type": "number", "description": "Дальность, на которой замечает героя, px" },
        "lunge": {
          "type": "object",
          "description": "Только hopper: заметив героя, подпрыгивает ближе, приседает и бросается на него, затем отходит",
          "required": ["sight", "range", "windup", "speed_y", "max_vx", "cooldown"],
          "properties": {
            "sight": { "type": "number", "description": "Дальность, на которой замечает героя и идёт на него, px" },
            "range": { "type": "number", "description": "С какого расстояния приседает перед броском, px" },
            "windup": { "type": "number", "description": "Приседание перед прыжком, с" },
            "speed_y": { "type": "number", "description": "Взлёт в прыжке, px/с" },
            "max_vx": { "type": "number", "description": "Потолок скорости вперёд в прыжке, px/с" },
            "cooldown": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "Пауза между бросками [мин, макс], с" }
          }
        },
        "shoot": {
          "type": "object",
          "description": "Только watcher: заряжает глаз и пускает синюю молнию, отражающуюся от стен",
          "required": ["sight", "windup", "cooldown", "count", "spread", "speed", "bounces", "life", "damage"],
          "properties": {
            "sight": { "type": "number", "description": "Дальность стрельбы, px" },
            "windup": { "type": "number", "description": "Зарядка глаза, с" },
            "cooldown": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "Пауза между залпами [мин, макс], с" },
            "count": { "type": "integer", "minimum": 1, "description": "Молний в залпе" },
            "spread": { "type": "number", "description": "Разброс залпа, рад" },
            "speed": { "type": "number", "description": "Скорость молнии, px/с" },
            "bounces": { "type": "integer", "minimum": 0, "description": "Сколько раз отражается от стен" },
            "life": { "type": "number", "description": "Сколько живёт молния, с" },
            "damage": { "type": "number", "description": "Урон герою" }
          }
        },
        "hit": {
          "type": "array", "minItems": 1, "description": "Круги попадания на холсте рига",
          "items": { "type": "object", "required": ["x", "y", "r"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "r": { "type": "number" } } }
        },
        "tail": {
          "type": "object",
          "required": ["root", "length"],
          "description": "Процедурный хвост-молния (рисуется поверх деталей, цвета — палитра проекта); с блоком whip зверёк иногда подбегает и хлещет героя",
          "properties": {
            "root": { "type": "object", "required": ["x", "y"], "description": "Корень хвоста на холсте", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
            "length": { "type": "number", "description": "Длина в покое, px" },
            "nodes": { "type": "integer", "minimum": 4, "maximum": 24, "description": "Узлов в цепочке, по умолчанию 11" },
            "whip": {
              "type": "object",
              "required": ["reach", "windup", "lash", "recover", "cooldown"],
              "properties": {
                "reach": { "type": "number", "description": "На сколько px вперёд от точки привязки дотягивается хлёст" },
                "windup": { "type": "number", "description": "Замах, с" },
                "lash": { "type": "number", "description": "Хлёст, с" },
                "recover": { "type": "number", "description": "Возврат хвоста, с" },
                "cooldown": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "description": "Пауза между хлёстами [мин, макс], с" }
              }
            }
          }
        },
        "parts": {
          "type": "array", "minItems": 1, "description": "Детали снизу вверх",
          "items": {
            "type": "object",
            "required": ["name", "sprite_id", "pivot"],
            "properties": {
              "name": { "type": "string" },
              "sprite_id": { "type": "string" },
              "pivot": { "type": "object", "required": ["x", "y"], "description": "Точка вращения на холсте", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "anims": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["type", "amp"],
                  "properties": {
                    "type": { "type": "string", "enum": ["step", "swing", "wag", "bob", "bounce", "flap", "squash", "track", "peck", "tuck", "sink"] },
                    "amp": { "type": "number" },
                    "rate": { "type": "number" },
                    "phase": { "type": "number" },
                    "lift": { "type": "number" },
                    "always": { "type": "boolean" },
                    "of": { "type": "string", "description": "sink: деталь выше в списке, за чьим смещением вниз идёт эта (вверх за ней не идёт)" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "wobbler": {
      "type": "object",
      "description": "Существо на фоне: тело и лапки — одна сетка со скиннингом; лапки ведёт цепочка костей, из пасти выплёвываются другие враги",
      "required": ["sprite_id", "mouth", "limbs"],
      "properties": {
        "sprite_id": { "type": "string", "description": "Полный рисунок существа (холст целиком) — текстура общей сетки" },
        "thread": {
          "type": "object",
          "required": ["sprite_id", "attach"],
          "description": "Нитка, на которой существо висит маятником: тайлится по вертикали, верхний конец закреплён на высоте anchor_y из уровня",
          "properties": {
            "sprite_id": { "type": "string", "description": "Кусок нитки (тайлится вдоль длины)" },
            "attach": { "type": "object", "required": ["x", "y"], "description": "Точка холста, к которой привязана нитка (макушка существа)", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
            "width_center": { "type": "number", "description": "Центр нитки по x в куске (px), по умолчанию половина ширины" }
          }
        },
        "mouth": { "type": "object", "required": ["x", "y"], "description": "Откуда вылетают плевки (px на холсте)", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
        "limbs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "sprite_id", "root"],
            "description": "Лапка: целый слой + корень; в игре режется на сегменты вдоль оси корень -> кончик и ведётся цепочкой костей",
            "properties": {
              "name": { "type": "string" },
              "sprite_id": { "type": "string", "description": "Полнохолстная маска лапки (какие пиксели рисунка — её)" },
              "root": { "type": "object", "required": ["x", "y"], "description": "Корень лапки (px на холсте): точка крепления к телу и начало первой кости", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "bones": { "type": "integer", "minimum": 2, "maximum": 16, "description": "Число костей (сегментов), по умолчанию 6" }
            }
          }
        }
      }
    },
    "bird_boss": {
      "type": "object",
      "description": "Босс-птица: слои на общем холсте (крылья машут вокруг плеч), точка тела, низ лап и круги попадания",
      "required": ["body", "feet_y", "draw_facing", "layers", "hit", "bird_sprite_id"],
      "properties": {
        "body": { "type": "object", "required": ["x", "y"], "description": "Точка тела на холсте: вокруг неё птица поворачивается и зеркалится", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
        "feet_y": { "type": "number", "description": "Низ лап на холсте (по нему птица садится на пол)" },
        "draw_facing": { "type": "integer", "enum": [-1, 1], "description": "Куда смотрит рисунок (−1 — влево)" },
        "bird_sprite_id": { "type": "string", "description": "Спрайт птички, которых босс выпускает (клюв вверх, рисуется по центру)" },
        "layers": {
          "type": "array", "minItems": 1, "description": "Слои снизу вверх",
          "items": {
            "type": "object", "required": ["name", "sprite_id"],
            "properties": {
              "name": { "type": "string" },
              "sprite_id": { "type": "string" },
              "wing": { "type": "string", "enum": ["left", "right"], "description": "Слой — крыло: машет вокруг pivot" },
              "pivot": { "type": "object", "required": ["x", "y"], "description": "Плечо крыла (или шея головы)", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }
            }
          }
        },
        "hit": {
          "type": "array", "minItems": 1, "description": "Круги попадания на холсте; круги крыльев качаются вместе с крылом",
          "items": {
            "type": "object", "required": ["part", "x", "y", "r"],
            "properties": {
              "part": { "type": "string", "enum": ["body", "head", "wing_l", "wing_r"] },
              "x": { "type": "number" }, "y": { "type": "number" }, "r": { "type": "number" }
            }
          }
        }
      }
    },
    "crab_boss": {
      "type": "object",
      "description": "Босс-краб: слои на общем холсте (ноги качаются вокруг бёдер), торс с кругами попадания, клешни на неоновых нитях, шары",
      "required": ["feet", "box", "height", "layers", "body_hit", "claw", "shoulders", "orb", "thread_length"],
      "properties": {
        "feet": { "type": "object", "required": ["x", "y"], "description": "Центр стоп на холсте (точка привязки к полу)", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
        "box": { "type": "object", "required": ["w", "h"], "description": "Коробка столкновений с тайлами, px", "properties": { "w": { "type": "number" }, "h": { "type": "number" } } },
        "height": { "type": "number", "description": "От стоп до макушки, px (камера держит верх босса в кадре)" },
        "thread_length": { "type": "number", "description": "Длина неоновой нити клешни, px" },
        "layers": {
          "type": "array", "minItems": 1, "description": "Слои снизу вверх",
          "items": {
            "type": "object", "required": ["name", "sprite_id", "role"],
            "properties": {
              "name": { "type": "string" },
              "sprite_id": { "type": "string" },
              "role": { "type": "string", "enum": ["torso", "leg_lb", "leg_lf", "leg_rf", "leg_rb"] },
              "pivot": { "type": "object", "required": ["x", "y"], "description": "Бедро ноги: вокруг него нога качается", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "foot_y": { "type": "number", "description": "Низ стопы на холсте: ноги подгоняются, чтобы все стояли на полу" }
            }
          }
        },
        "body_hit": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["x", "y", "r"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "r": { "type": "number" } } } },
        "claw": {
          "type": "object", "required": ["sprite_id", "pivot", "length", "hit"],
          "properties": {
            "sprite_id": { "type": "string" },
            "pivot": { "type": "object", "required": ["x", "y"], "description": "«Запястье» клешни в её спрайте: сюда крепится нить", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
            "length": { "type": "number", "description": "От запястья до кончика клешни, px" },
            "hit": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["x", "y", "r"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "r": { "type": "number" } } } }
          }
        },
        "shoulders": {
          "type": "object", "required": ["left", "right"], "description": "Точки крепления нитей к торсу на холсте",
          "properties": { "left": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }, "right": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } } }
        },
        "orb": { "type": "object", "required": ["sprite_id", "radius"], "properties": { "sprite_id": { "type": "string" }, "radius": { "type": "number" } } }
      }
    },
    "segmented": {
      "type": "object",
      "description": "Сегментированное существо (червь): голова, туловище, хвост едут по следу головы",
      "required": ["thickness", "length_min", "length_max", "head", "body", "tail", "head_to_body", "body_to_body", "body_to_tail"],
      "properties": {
        "thickness": { "type": "number", "minimum": 1, "description": "Толщина червя, px (центр ползёт на половине толщины от поверхности)" },
        "length_min": { "type": "integer", "minimum": 2 },
        "length_max": { "type": "integer", "minimum": 2 },
        "head": { "$ref": "#/$defs/segment" },
        "body": { "$ref": "#/$defs/segment" },
        "tail": { "$ref": "#/$defs/segment" },
        "head_to_body": { "type": "number", "description": "Расстояние между центрами головы и первого туловища вдоль следа, px" },
        "body_to_body": { "type": "number" },
        "body_to_tail": { "type": "number" },
        "health": {
          "type": "object",
          "required": ["body", "tail"],
          "description": "Здоровье частей: у каждой своё; выбитая часть исчезает, гибель головы — гибель существа",
          "properties": {
            "head": { "type": "number", "minimum": 1, "description": "По умолчанию stats.max_health врага" },
            "body": { "type": "number", "minimum": 1 },
            "tail": { "type": "number", "minimum": 1 }
          }
        },
        "flight": {
          "type": "object",
          "description": "Босс-червь летает: голова доворачивает к герою, проносится мимо и делает петли",
          "required": ["turn_rate", "pass_distance", "pass_time", "boost", "wave"],
          "properties": {
            "turn_rate": { "type": "number", "minimum": 0.1, "description": "Скорость поворота головы, рад/с (меньше — шире петли)" },
            "pass_distance": { "type": "number", "minimum": 1, "description": "Ближе этого к герою голова перестаёт доворачивать и проносится мимо, px" },
            "pass_time": { "type": "array", "items": { "type": "number", "minimum": 0.1 }, "minItems": 2, "maxItems": 2, "description": "Сколько длится пролёт, с: [от, до]" },
            "boost": { "type": "number", "minimum": 1, "description": "Во сколько раз быстрее при пролёте" },
            "wave": {
              "type": "object",
              "required": ["amp", "k"],
              "description": "Извивание тела",
              "properties": {
                "amp": { "type": "number", "minimum": 0, "description": "Поперечная амплитуда, px" },
                "k": { "type": "number", "minimum": 0, "description": "Фазовая скорость вдоль тела, рад/px" }
              }
            }
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "description": "Части снизу вверх (порядок отрисовки)",
      "items": {
        "type": "object",
        "required": ["name", "sprite_id", "role", "pivot"],
        "properties": {
          "name": { "type": "string", "description": "Имя слоя в .aseprite" },
          "sprite_id": { "type": "string", "description": "Id из data/sprites/sprites.json" },
          "role": { "type": "string", "enum": ["head", "torso", "arm", "leg"] },
          "side": { "type": "integer", "enum": [-1, 1], "description": "Для рук и ног: 1 — левая на экране (Fhand/Fleg), -1 — правая" },
          "pivot": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "face": {
            "type": "object",
            "required": ["max_shift"],
            "description": "Только для head: лицо сдвигается по черепу в сторону курсора. Либо отдельный слой лица (sprite_id, например глаза), либо слой головы режется на череп и лицо (feature_colors — пиксели этих цветов: глаза, брови, рот)",
            "properties": {
              "sprite_id": { "type": "string", "description": "Отдельный слой лица на том же холсте, что и голова (рисуется поверх головы); тогда feature_colors и region не нужны" },
              "feature_colors": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
              "region": {
                "type": "object",
                "required": ["x0", "y0", "x1", "y1"],
                "description": "Прямоугольник на холсте (включительно), где искать черты: вне него пиксели остаются на черепе (например, трещина на шлеме и рот не двигаются — только глаза)",
                "properties": { "x0": { "type": "integer" }, "y0": { "type": "integer" }, "x1": { "type": "integer" }, "y1": { "type": "integer" } }
              },
              "max_shift": {
                "type": "object",
                "required": ["x", "y"],
                "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } }
              }
            }
          },
          "gaze_origin": {
            "type": "object",
            "required": ["x", "y"],
            "description": "Только для head: середина глаз на холсте (px). Голова смотрит вбок (вперёд = +x по взгляду), поэтому она поворачивается так, чтобы взгляд от этой точки шёл на курсор",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "length": { "type": "number", "minimum": 1, "description": "Только для leg: длина ноги от бедра до стопы, px" },
          "rope": {
            "type": "object",
            "description": "Только для arm: слой режется вдоль оси плечо→кисть на segments сегментов, поведение — физика каната",
            "required": ["segments"],
            "properties": { "segments": { "type": "integer", "minimum": 2, "maximum": 12 } }
          }
        }
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "required": ["sprite_id", "center"],
      "properties": {
        "sprite_id": { "type": "string", "description": "Слой-часть (полный холст); рисунок смотрит «вверх» = вперёд" },
        "center": { "type": "object", "required": ["x", "y"], "description": "Центр части на холсте (px) — точка вращения и позиции на следе", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
        "scale": { "type": "number", "minimum": 0.05, "description": "Масштаб рисунка части (по умолчанию 1)" },
        "hit_radius": { "type": "number", "minimum": 1, "description": "Круг попадания, px (по умолчанию — половина толщины)" },
        "under": { "type": "array", "items": { "$ref": "#/$defs/attachment" }, "description": "Детали позади рисунка части (щупальца головы)" },
        "over": { "type": "array", "items": { "$ref": "#/$defs/attachment" }, "description": "Детали поверх рисунка части (прячут стык щупалец)" }
      }
    },
    "attachment": {
      "type": "object",
      "required": ["sprite_id"],
      "description": "Слой-деталь на полном холсте рига, едет вместе с частью; с pivot и sway качается вокруг точки крепления",
      "properties": {
        "sprite_id": { "type": "string" },
        "pivot": { "type": "object", "required": ["x", "y"], "description": "Точка крепления на холсте", "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
        "sway": { "type": "number", "minimum": 0, "description": "Амплитуда качания, рад" },
        "speed": { "type": "number", "description": "Скорость качания, рад/с" },
        "phase": { "type": "number", "description": "Сдвиг фазы, рад" }
      }
    }
  }
}
