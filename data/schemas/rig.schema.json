{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rig",
  "description": "Процедурный риг персонажа из частей-слоёв. Все части — полнохолстные спрайты в одних координатах; pivot задаёт точку вращения.",
  "type": "object",
  "required": ["id", "canvas", "anchor", "parts"],
  "properties": {
    "id": { "type": "string" },
    "description": { "type": "string" },
    "canvas": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "anchor": {
      "type": "object",
      "description": "Точка холста, которая ставится в позицию тела (ноги, низ по центру)",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
    },
    "crawler": {
      "type": "object",
      "description": "Ползающее существо (паук): тело на двухфаланговых ногах",
      "required": ["body_raise", "legs"],
      "properties": {
        "body_raise": { "type": "number", "minimum": 0, "description": "На сколько px тело поднято над поверхностью ногами" },
        "leg_spread": { "type": "number", "minimum": 0, "description": "Множитель разноса стоп (1 — как в рисунке)" },
        "leg_splay": { "type": "number", "minimum": 0, "description": "Дополнительный разброс стоп наружу от центра тела, px" },
        "body_centre_x": { "type": "number", "description": "Центр тела по X на холсте (px); по умолчанию — якорь" },
        "legs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "upper_sprite_id", "lower_sprite_id", "hip", "knee", "foot", "gait_group"],
            "properties": {
              "name": { "type": "string" },
              "upper_sprite_id": { "type": "string", "description": "Верхняя фаланга (бедро -> колено), id спрайта-слоя" },
              "lower_sprite_id": { "type": "string", "description": "Нижняя фаланга (колено -> стопа), id спрайта-слоя" },
              "hip": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "knee": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
              "foot": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
                }
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "description": "Части снизу вверх (порядок отрисовки)",
      "items": {
        "type": "object",
        "required": ["name", "sprite_id", "role", "pivot"],
        "properties": {
          "name": { "type": "string", "description": "Имя слоя в .aseprite" },
          "sprite_id": { "type": "string", "description": "Id из data/sprites/sprites.json" },
          "role": { "type": "string", "enum": ["head", "torso", "arm", "leg"] },
          "side": { "type": "integer", "enum": [-1, 1], "description": "Для рук и ног: 1 — левая на экране (Fhand/Fleg), -1 — правая" },
          "pivot": {
            "type": "object",
            "required": ["x", "y"],
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "face": {
            "type": "object",
            "required": ["feature_colors", "max_shift"],
            "description": "Только для head: слой режется на череп и лицо (пиксели этих цветов — глаза, брови, рот); лицо сдвигается по черепу в сторону курсора",
            "properties": {
              "feature_colors": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } },
              "region": {
                "type": "object",
                "required": ["x0", "y0", "x1", "y1"],
                "description": "Прямоугольник на холсте (включительно), где искать черты: вне него пиксели остаются на черепе (например, трещина на шлеме и рот не двигаются — только глаза)",
                "properties": { "x0": { "type": "integer" }, "y0": { "type": "integer" }, "x1": { "type": "integer" }, "y1": { "type": "integer" } }
              },
              "max_shift": {
                "type": "object",
                "required": ["x", "y"],
                "properties": { "x": { "type": "number", "minimum": 0 }, "y": { "type": "number", "minimum": 0 } }
              }
            }
          },
          "gaze_origin": {
            "type": "object",
            "required": ["x", "y"],
            "description": "Только для head: середина глаз на холсте (px). Голова смотрит вбок (вперёд = +x по взгляду), поэтому она поворачивается так, чтобы взгляд от этой точки шёл на курсор",
            "properties": { "x": { "type": "number" }, "y": { "type": "number" } }
          },
          "length": { "type": "number", "minimum": 1, "description": "Только для leg: длина ноги от бедра до стопы, px" },
          "rope": {
            "type": "object",
            "description": "Только для arm: слой режется вдоль оси плечо→кисть на segments сегментов, поведение — физика каната",
            "required": ["segments"],
            "properties": { "segments": { "type": "integer", "minimum": 2, "maximum": 12 } }
          }
        }
      }
    }
  }
}
