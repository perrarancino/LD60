{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TileSet",
  "description": "Определения тайлов уровня. Один тайл = один спрайт (категория tiles) квадратного размера tile_size.",
  "type": "object",
  "required": ["version", "tile_size", "tiles"],
  "properties": {
    "version": { "type": "string" },
    "tile_size": { "type": "integer", "minimum": 1, "description": "Сторона тайла в пикселях виртуального разрешения" },
    "tiles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sprite_id", "solid"],
        "properties": {
          "id": { "type": "string", "description": "Id тайла; используется в легенде уровня" },
          "display_name": { "type": "string" },
          "sprite_id": { "type": "string", "description": "Id спрайта из data/sprites/sprites.json" },
          "solid": { "type": "boolean", "description": "Твёрдый тайл блокирует движение" },
          "one_way": { "type": "boolean", "description": "Проходим снизу, твёрд сверху (платформа-«облачко»)" }
        }
      }
    }
  }
}
